{
  "name": "upnassist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "dev:network": "vite --host",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && npm run check:errors",
    "build:vercel": "npm run build",
    "build:analyze": "ANALYZE=true npm run build",
    "check:errors": "node scripts/check-browser-errors.cjs",
    "check:errors:dev": "set CHECK_URL=http://localhost:5173 && node scripts/check-browser-errors.cjs",
    "check:errors:preview": "set CHECK_URL=http://localhost:4173 && node scripts/check-browser-errors.cjs",
    "check:enhanced": "node scripts/check-browser-errors-enhanced.cjs",
    "check:enhanced:dev": "set CHECK_URL=http://localhost:5173 && node scripts/check-browser-errors-enhanced.cjs",
    "check:enhanced:preview": "set CHECK_URL=http://localhost:4173 && node scripts/check-browser-errors-enhanced.cjs",
    "fix:errors": "node scripts/auto-fix-errors.js",
    "check:auto": "node scripts/continuous-check.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:network": "vite preview --host",
    "test": "vitest --config vitest.config.ts",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --watch --config vitest.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/react-window": "^1.8.8",
    "@vercel/kv": "^3.0.0",
    "@vercel/node": "^5.3.7",
    "firebase": "^12.0.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.2",
    "react-markdown": "^10.1.0",
    "react-resizable": "^3.0.5",
    "react-resizable-panels": "^4.3.0",
    "react-router-dom": "^7.6.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "website-scraper": "^6.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@mlc-ai/web-llm": "^0.2.46",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.3",
    "autoprefixer": "^10.4.21",
    "chalk": "^4.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^14.12.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.54.1",
    "postcss": "^8.5.4",
    "puppeteer": "^24.17.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.43.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "description": "<div align=\"center\">   <img src=\"public/logo.png\" alt=\"UpnAssist Logo\" width=\"200\" />",
